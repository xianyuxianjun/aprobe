# 复制成 .env 后填入真值。.env 已被 .gitignore 忽略，不会进仓库。
#
# 只有需要模型的功能会读这些值：`aprobe generate --mode agent` 与 `aprobe diagnose`。
# 其余命令（validate / run / report / evaluate）永远不调模型。
#
# 优先级：真实环境变量 > .env。所以 `FOO=bar aprobe ...` 仍然能临时覆盖这里的值。

# OpenAI-compatible 端点。本地模型示例见下方注释。
APROBE_MODEL_BASE_URL=https://api.example.com/v1
APROBE_MODEL=your-model-name
APROBE_MODEL_API_KEY=sk-replace-me

# 请求超时，毫秒，默认 60000
# APROBE_MODEL_TIMEOUT_MS=60000

# 本地模型（不需要 API key：没有 key 时客户端不会发送 Authorization 头）
#   ollama pull qwen3:8b && ollama serve
# APROBE_MODEL_BASE_URL=http://127.0.0.1:11434/v1
# APROBE_MODEL=qwen3:8b
# APROBE_MODEL_API_KEY=

# 注意：模型必须支持 tool calling（function calling），否则循环会以
# planner_failed（退出码 2）明确终止，而不是静默产出无用的用例。
